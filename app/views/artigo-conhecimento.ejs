<!DOCTYPE html><html lang="pt-br"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= artigo.title %> - TaskBee</title><link rel="stylesheet" href="/css/global.css"><link rel="stylesheet" href="/css/base-de-conhecimento.css"></head><body><%- include('partials/header') %><main id="conteudo-principal" class="kb-container artigo"><a href="/base-de-conhecimento">← Base de conhecimento</a><article><span><%= artigo.categoria || 'Geral' %></span><h1><%= artigo.title %></h1><small>Por <%= artigo.autor || 'Sistema' %> · <%= new Date(artigo.created_at).toLocaleDateString('pt-BR') %></small><div class="conteudo-artigo"><%= artigo.content %></div></article><section class="feedback-artigo"><p>Este artigo ajudou?</p><form action="/base-de-conhecimento/<%= artigo.id %>/feedback" method="POST"><button name="util" value="1">Sim</button><button name="util" value="0">Não</button></form></section></main><%- include('partials/footer') %></body></html>
