<!DOCTYPE html><html lang="pt-br"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Base de conhecimento - TaskBee</title><link rel="stylesheet" href="/css/global.css"><link rel="stylesheet" href="/css/base-de-conhecimento.css"><%- include('partials/appearance') %>
</head><body><%- include('partials/header') %>
<main id="conteudo-principal" class="kb-container"><header><h1>Base de conhecimento</h1><p>Encontre soluções documentadas antes de abrir um chamado.</p><form method="GET"><input type="search" name="busca" value="<%= busca %>" placeholder="Pesquisar artigos"><button>Pesquisar</button></form></header>
<% if (sucesso) { %><p class="kb-feedback"><%= sucesso %></p><% } %>
<section class="kb-grade"><div class="kb-artigos"><% if (artigos.length) { artigos.forEach(item => { %><article><span><%= item.categoria || 'Geral' %></span><h2><a href="/base-de-conhecimento/<%= item.id %>"><%= item.title %></a></h2><p><%= item.content.slice(0,180) %><%= item.content.length > 180 ? '…' : '' %></p><small><%= item.views_count %> visualizações · <%= item.autor || 'Sistema' %></small></article><% }) } else { %><p>Nenhum artigo encontrado.</p><% } %></div>
<% if (equipe) { %><aside class="kb-editor"><h2>Novo artigo</h2><form action="/base-de-conhecimento/artigos" method="POST"><label>Título<input name="titulo" maxlength="200" required></label><label>Categoria<select name="categoria_id"><option value="">Geral</option><% categorias.forEach(item => { %><option value="<%= item.id %>"><%= item.name %></option><% }) %></select></label><label>Conteúdo<textarea name="conteudo" rows="10" minlength="20" required></textarea></label><button>Publicar artigo</button></form><h3>Nova categoria</h3><form action="/base-de-conhecimento/categorias" method="POST" class="linha"><input name="nome" maxlength="100" required><button>Adicionar</button></form></aside><% } %></section></main><%- include('partials/footer') %></body></html>
