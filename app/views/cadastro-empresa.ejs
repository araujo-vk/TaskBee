<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Empresa - TaskBee</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/cadastro-empresa.css">
    <link rel="shortcut icon" type="image/x-icon" href="/TaskBee-Icon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <%- include('partials/header') %>
    <div class="container">
    <p>Cadastro de Empresa</p>

    <% if (typeof mensagem !== 'undefined' && mensagem) { %>
        <p style="color: var(--cor-laranja);"><%= mensagem %></p>
    <% } %>
    <div class="form-container">
    <form action="/cadastro-empresa" method="POST">
        <label for="nome">Nome da Empresa:</label>
        <input type="text" id="nome" name="nome" required><br>

        <label for="cnpj">CNPJ:</label>
        <input type="text" id="cnpj" name="cnpj" required><br>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" required><br>

        <label for="senha">Senha:</label>
        <input type="password" id="senha" name="senha" required><br>

        <button type="submit">Cadastrar</button>
    </form>
    </div>
    <a href="/cadastro">Precisa cadastrar um usuário?</a><br>
    <a href="/login">Já possui uma conta? Faça login</a>
    </div>
    <%- include('partials/footer') %>
</body>
</html>