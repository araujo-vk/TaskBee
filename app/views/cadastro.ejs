<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - TaskBee</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/cadastro.css">
    <link rel="shortcut icon" type="image/x-icon" href="/TaskBee-Icon.ico">
    <script>
        (function() {
            // Usa 'locals.usuario' para evitar erros caso o usuário não esteja logado
            const backendTheme = '<%= (locals.usuario && usuario.tema) ? usuario.tema : "" %>';
            const localTheme = localStorage.getItem('tema');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            
            let themeToApply = 'light';
            
            // 1. Se houver preferência vinda do banco de dados (usuário logado)
            if (backendTheme && backendTheme !== 'system' && backendTheme !== '') {
                themeToApply = backendTheme;
            } 
            // 2. Se houver preferência no localStorage (visitante que já mudou o tema)
            else if (localTheme && localTheme !== 'system' && localTheme !== '') {
                themeToApply = localTheme;
            } 
            // 3. Senão, adota a preferência do sistema operacional/navegador
            else if (systemPrefersDark) {
                themeToApply = 'dark';
            }
            
            // Aplica imediatamente na tag <html> para evitar a tela branca ao carregar
            if (themeToApply === 'dark') {
                document.documentElement.classList.add('dark-mode');
            } else {
                document.documentElement.classList.remove('dark-mode');
            }
        })();
    </script>
</head>
<body>
    <%- include('partials/header') %>

    <div class="container">
        <p>Cadastro de Usuário</p>

        <% if (typeof mensagem !== 'undefined' && mensagem) { %>
            <p style="color: var(--cor-laranja); font-size: 13px; font-weight: 500;"><%= mensagem %></p>
        <% } %>

        <div class="form-container">
            <form action="/cadastro" method="POST">
                <label for="cnpj_empresa">CNPJ da Empresa:</label>
                <input type="text" id="cnpj_empresa" name="cnpj_empresa" placeholder="00.000.000/0001-00" required>

                <label for="nome">Nome completo:</label>
                <input type="text" id="nome" name="nome" required>

                <label for="email">Email:</label>
                <input type="email" id="email" name="email" required>

                <label for="senha">Senha:</label>
                <input type="password" id="senha" name="senha" required>

                <button type="submit">Cadastrar</button>
            </form>
        </div>

        <a href="/cadastro-empresa">Precisa cadastrar uma empresa?</a><br>
        <a href="/login">Já possui uma conta? Faça login</a>
    </div>

    <%- include('partials/footer') %>
</body>
</html>