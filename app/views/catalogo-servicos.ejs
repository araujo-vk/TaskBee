<!DOCTYPE html><html lang="pt-br"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Catálogo de serviços - TaskBee</title><link rel="stylesheet" href="/css/global.css"><link rel="stylesheet" href="/css/catalogo-servicos.css"></head><body>
<%- include('partials/header') %><main id="conteudo-principal" class="catalogo-container"><header><h1>Catálogo de serviços</h1><p>Encontre o serviço adequado e abra um chamado com mais contexto.</p><form action="/catalogo-servicos" method="GET"><input type="search" name="busca" value="<%= busca %>" placeholder="Pesquisar serviço"><button type="submit">Pesquisar</button></form></header>
<section class="grade-servicos"><% if (servicos.length) { servicos.forEach(item => { %><article class="servico-card"><span><%= item.categoria || 'Serviço geral' %></span><h2><%= item.name %></h2><p><%= item.description || 'Sem descrição.' %></p><small><%= item.resolution_time_minutes ? `Prazo de referência: ${Math.round(item.resolution_time_minutes / 60)} h` : 'SLA conforme a prioridade' %></small><a href="/chamados/novo?servico_id=<%= item.id %>">Solicitar serviço</a></article><% }) } else { %><p>Nenhum serviço encontrado.</p><% } %></section></main><%- include('partials/footer') %></body></html>
