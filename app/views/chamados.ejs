<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meus Chamados - TaskBee</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/chamados.css">
    <link rel="shortcut icon" type="image/x-icon" href="/TaskBee-Icon.ico">
    <script>
        (function() {
            // Usa 'locals.usuario' para evitar erros caso o usuário não esteja logado
            const backendTheme = '<%= (locals.usuario && usuario.tema) ? usuario.tema : "" %>';
            const localTheme = localStorage.getItem('tema');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            
            let themeToApply = 'light';
            
            // 1. Se houver preferência vinda do banco de dados (usuário logado)
            if (backendTheme && backendTheme !== 'system' && backendTheme !== '') {
                themeToApply = backendTheme;
            } 
            // 2. Se houver preferência no localStorage (visitante que já mudou o tema)
            else if (localTheme && localTheme !== 'system' && localTheme !== '') {
                themeToApply = localTheme;
            } 
            // 3. Senão, adota a preferência do sistema operacional/navegador
            else if (systemPrefersDark) {
                themeToApply = 'dark';
            }
            
            // Aplica imediatamente na tag <html> para evitar a tela branca ao carregar
            if (themeToApply === 'dark') {
                document.documentElement.classList.add('dark-mode');
            } else {
                document.documentElement.classList.remove('dark-mode');
            }
        })();
    </script>
</head>
<body>
    <%- include('partials/header') %>

    <main class="conteudo-chamados">
        <div class="cabecalho-chamados">
            <h2>Lista de Chamados</h2>
            <a href="/chamados/novo" class="btn-novo-chamado">+ Criar Novo Chamado</a>
        </div>

        <div class="tabela-responsiva">
            <table class="tabela-chamados">
                <thead>
                    <tr>
                        <th>
                            <a href="/chamados?sort=id&order=<%= sortAtual === 'id' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>">
                                ID <%= sortAtual === 'id' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>
                            <a href="/chamados?sort=nome&order=<%= sortAtual === 'nome' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>">
                                Título <%= sortAtual === 'nome' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>
                            <a href="/chamados?sort=solicitante&order=<%= sortAtual === 'solicitante' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>">
                                Solicitante <%= sortAtual === 'solicitante' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>
                            <a href="/chamados?sort=tipo&order=<%= sortAtual === 'tipo' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>">
                                Tipo <%= sortAtual === 'tipo' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>
                            <a href="/chamados?sort=status&order=<%= sortAtual === 'status' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>">
                                Estado <%= sortAtual === 'status' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>
                            <a href="/chamados?sort=data&order=<%= sortAtual === 'data' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>">
                                Data <%= sortAtual === 'data' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (chamados.length === 0) { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 30px;">Nenhum chamado encontrado.</td>
                        </tr>
                    <% } else { %>
                        <% chamados.forEach(c => { %>
                            <tr>
                                <td>#<%= c.id %></td>
                                <td><strong><%= c.titulo %></strong></td>
                                <td><%= c.solicitante %></td>
                                <td><%= c.tipo %></td>
                                <td><%= c.status %></td>
                                <td><%= new Date(c.dataCriacao).toLocaleDateString('pt-BR') %></td>
                                <td><a href="/chamados/<%= c.id %>" class="link-detalhes">Ver Detalhes</a></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>