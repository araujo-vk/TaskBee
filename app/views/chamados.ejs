<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meus Chamados - TaskBee</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/chamados.css">
    <link rel="shortcut icon" type="image/x-icon" href="/TaskBee-Icon.ico">
    <script>
        (function() {
            // Usa 'locals.usuario' para evitar erros caso o usuário não esteja logado
            const backendTheme = '<%= (locals.usuario && usuario.tema) ? usuario.tema : "" %>';
            const localTheme = localStorage.getItem('tema');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            
            let themeToApply = 'light';
            
            // 1. Se houver preferência vinda do banco de dados (usuário logado)
            if (backendTheme && backendTheme !== 'system' && backendTheme !== '') {
                themeToApply = backendTheme;
            } 
            // 2. Se houver preferência no localStorage (visitante que já mudou o tema)
            else if (localTheme && localTheme !== 'system' && localTheme !== '') {
                themeToApply = localTheme;
            } 
            // 3. Senão, adota a preferência do sistema operacional/navegador
            else if (systemPrefersDark) {
                themeToApply = 'dark';
            }
            
            // Aplica imediatamente na tag <html> para evitar a tela branca ao carregar
            if (themeToApply === 'dark') {
                document.documentElement.classList.add('dark-mode');
            } else {
                document.documentElement.classList.remove('dark-mode');
            }
        })();
    </script>
</head>
<body>
    <%- include('partials/header') %>

    <main id="conteudo-principal" class="conteudo-chamados">
        <div class="cabecalho-chamados">
            <h2>Lista de Chamados</h2>
            <div class="acoes-lista-chamados">
                <% if (usuario && [1, 2, 3].includes(Number(usuario.roleId))) { %>
                    <a href="/exportar/chamados.csv" class="btn-exportar">Exportar CSV</a>
                <% } %>
                <a href="/chamados/novo" class="btn-novo-chamado">+ Criar Novo Chamado</a>
            </div>
        </div>

        <form class="filtros-chamados" action="/chamados" method="GET">
            <label>Buscar <input type="search" name="busca" value="<%= filtros.busca %>" placeholder="ID, título ou descrição"></label>
            <label>Status <select name="status_id"><option value="">Todos</option><% status.forEach(item => { %><option value="<%= item.id %>" <%= Number(filtros.statusId) === Number(item.id) ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label>
            <label>Prioridade <select name="prioridade_id"><option value="">Todas</option><% prioridades.forEach(item => { %><option value="<%= item.id %>" <%= Number(filtros.prioridadeId) === Number(item.id) ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label>
            <label>Categoria <select name="categoria_id"><option value="">Todas</option><% categorias.forEach(item => { %><option value="<%= item.id %>" <%= Number(filtros.categoriaId) === Number(item.id) ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label>
            <button type="submit">Filtrar</button>
            <a href="/chamados">Limpar</a>
        </form>

        <div class="tabela-responsiva">
            <table class="tabela-chamados">
                <thead>
                    <tr>
                        <th>
                            <a href="/chamados?sort=id&order=<%= sortAtual === 'id' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>&<%= queryBase %>">
                                ID <%= sortAtual === 'id' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>
                            <a href="/chamados?sort=nome&order=<%= sortAtual === 'nome' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>&<%= queryBase %>">
                                Título <%= sortAtual === 'nome' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>
                            <a href="/chamados?sort=solicitante&order=<%= sortAtual === 'solicitante' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>&<%= queryBase %>">
                                Solicitante <%= sortAtual === 'solicitante' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>
                            <a href="/chamados?sort=tipo&order=<%= sortAtual === 'tipo' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>&<%= queryBase %>">
                                Tipo <%= sortAtual === 'tipo' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>Categoria</th>
                        <th>Prioridade</th>
                        <th>
                            <a href="/chamados?sort=status&order=<%= sortAtual === 'status' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>&<%= queryBase %>">
                                Estado <%= sortAtual === 'status' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>
                            <a href="/chamados?sort=data&order=<%= sortAtual === 'data' && ordemAtual === 'ASC' ? 'desc' : 'asc' %>&<%= queryBase %>">
                                Data <%= sortAtual === 'data' ? (ordemAtual === 'ASC' ? '▲' : '▼') : '' %>
                            </a>
                        </th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (chamados.length === 0) { %>
                        <tr>
                            <td colspan="9" style="text-align: center; padding: 30px;">Nenhum chamado encontrado.</td>
                        </tr>
                    <% } else { %>
                        <% chamados.forEach(c => { %>
                            <tr>
                                <td>#<%= c.id %></td>
                                <td><strong><%= c.titulo %></strong></td>
                                <td><%= c.solicitante %></td>
                                <td><%= c.tipo %></td>
                                <td><%= c.categoria || '—' %></td>
                                <td><%= c.prioridade || '—' %></td>
                                <td><%= c.status %></td>
                                <td><%= new Date(c.dataCriacao).toLocaleDateString('pt-BR') %></td>
                                <td><a href="/chamados/<%= c.id %>" class="link-detalhes">Ver Detalhes</a></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
        <% if (totalPaginas > 1) { %><nav class="paginacao" aria-label="Paginação"><% for (let p = 1; p <= totalPaginas; p += 1) { %><a href="/chamados?pagina=<%= p %>&sort=<%= sortAtual %>&order=<%= ordemAtual.toLowerCase() %>&<%= queryBase %>" class="<%= p === paginaAtual ? 'ativo' : '' %>"><%= p %></a><% } %></nav><% } %>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
