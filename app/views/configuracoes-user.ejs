<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurações - TaskBee</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/configuracoes-user.css">
    <link rel="shortcut icon" type="image/x-icon" href="/TaskBee-Icon.ico">
    
    <script>
        (function() {
            // Usa 'locals.usuario' para evitar erros caso o usuário não esteja logado
            const backendTheme = '<%= (locals.usuario && usuario.tema) ? usuario.tema : "" %>';
            const localTheme = localStorage.getItem('tema');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            
            let themeToApply = 'light';
            
            // 1. Se houver preferência vinda do banco de dados (usuário logado)
            if (backendTheme && backendTheme !== 'system' && backendTheme !== '') {
                themeToApply = backendTheme;
            } 
            // 2. Se houver preferência no localStorage (visitante que já mudou o tema)
            else if (localTheme && localTheme !== 'system' && localTheme !== '') {
                themeToApply = localTheme;
            } 
            // 3. Senão, adota a preferência do sistema operacional/navegador
            else if (systemPrefersDark) {
                themeToApply = 'dark';
            }
            
            // Aplica imediatamente na tag <html> para evitar a tela branca ao carregar
            if (themeToApply === 'dark') {
                document.documentElement.classList.add('dark-mode');
            } else {
                document.documentElement.classList.remove('dark-mode');
            }
        })();
    </script>
</head>
<body>
    <%- include('partials/header') %>
    
    <main class="conteudo-config">
        <div class="cabecalho-config">
            <h2>Configurações da Conta</h2>
        </div>

        <div class="config-grid">
            
            <!-- COLUNA ESQUERDA: Cartão de Perfil -->
            <aside class="perfil-card">
                <div class="avatar-perfil">🐝</div>
                <h3><%= usuario.nome %></h3>
                
                <% 
                    let roleName = "Usuário"; 
                    let roleClass = "user"; 
                    if (usuario.role_id == 1) { roleName = "Administrador"; roleClass = "admin"; } 
                    else if (usuario.role_id == 2) { roleName = "Gestor"; roleClass = "gestor"; } 
                    else if (usuario.role_id == 3) { roleName = "Técnico"; roleClass = "tecnico"; } 
                %>
                <span class="tag-role <%= roleClass %>"><%= roleName %></span>

                <hr class="divisor-perfil">

                <div class="info-group">
                    <span class="info-title">Departamento</span>
                    <span class="info-value"><%= usuario.departamento || 'Não atribuído' %></span>
                </div>

                <div class="info-group">
                    <span class="info-title">CNPJ do Tenant</span>
                    <span class="info-value"><%= usuario.cnpj_tenant || 'N/A' %></span>
                </div>

                <div class="info-group">
                    <span class="info-title">Data de Criação</span>
                    <span class="info-value">
                        <%= usuario.created_at ? new Date(usuario.created_at).toLocaleDateString('pt-PT') : '--' %>
                    </span>
                </div>

                <div class="abelha-badge">
                    Já é uma abelha há <strong>
                        <%= usuario.created_at ? Math.floor((Date.now() - new Date(usuario.created_at)) / (1000 * 60 * 60 * 24)) : 0 %> dias!
                    </strong>
                </div>
            </aside>

            <!-- COLUNA DIREITA: Formulário de Edição -->
            <section class="form-card">
                <h3>Editar Informações</h3>

                <% if (typeof erro !== 'undefined' && erro) { %>
                    <div class="feedback-msg erro"><%= erro %></div>
                <% } %>
                <% if (typeof sucesso !== 'undefined' && sucesso) { %>
                    <div class="feedback-msg sucesso"><%= sucesso %></div>
                <% } %>

                <!-- SEÇÃO DE PREFERÊNCIA DE TEMA DA INTERFACE -->
                <div class="form-group" style="margin-bottom: 25px;">
                    <label for="seletor-tema">Aparência do Sistema</label>
                    <select id="seletor-tema" class="select-config">
                        <option value="system">Padrão do Sistema (Automático)</option>
                        <option value="light">Modo Claro</option>
                        <option value="dark">Modo Escuro</option>
                    </select>
                </div>

                <hr style="border: 0; border-top: 1px solid var(--borda-elemento); margin-bottom: 20px;">

                <form action="/configuracoes-user/update" method="POST" class="form-config">
                    <div class="form-group">
                        <label for="nome">Nome do Usuário</label>
                        <input type="text" id="nome" name="nome" value="<%= usuario.nome %>" required>
                    </div>

                    <div class="form-group">
                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" value="<%= usuario.email %>" required>
                    </div>

                    <h4 class="subtitulo-form">Segurança</h4>
                    <p class="dica-senha">Deixe em branco se não quiser alterar a senha.</p>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="senha">Nova Senha</label>
                            <input type="password" id="senha" name="senha" placeholder="Digite a nova senha">
                        </div>

                        <div class="form-group">
                            <label for="confirmar-senha">Confirmar Nova Senha</label>
                            <input type="password" id="confirmar-senha" name="confirmar-senha" placeholder="Confirme a nova senha">
                            <span id="mensagem-senha" class="mensagem-senha-valida"></span>
                        </div>
                    </div>

                    <div class="botoes-acao">
                        <button type="submit" class="btn-salvar" id="btn-salvar">Salvar Alterações</button>
                    </div>
                </form>
            </section>

            <!-- Script de Validação de Senha e Troca de Tema -->
            <script>
                // --- LÓGICA DO SELETOR DE TEMA ---
                const seletorTema = document.getElementById('seletor-tema');
                
                // Define a opção selecionada no carregamento
                const temaAtualBackend = '<%= usuario.tema %>';
                seletorTema.value = temaAtualBackend || localStorage.getItem('tema') || 'system';

                seletorTema.addEventListener('change', async (e) => {
                    const novoTema = e.target.value;

                    // 1. Aplica as mudanças no DOM imediatamente
                    if (novoTema === 'dark') {
                        document.documentElement.classList.add('dark-mode');
                    } else if (novoTema === 'light') {
                        document.documentElement.classList.remove('dark-mode');
                    } else {
                        // Se selecionou 'system', checa a preferência do SO/Navegador
                        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                        document.documentElement.classList.toggle('dark-mode', systemPrefersDark);
                    }

                    // 2. Salva localmente
                    localStorage.setItem('tema', novoTema);

                    // 3. Atualiza no backend sem recarregar a página
                    try {
                        await fetch('/api/atualizar-tema', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ tema: novoTema })
                        });
                    } catch (error) {
                        console.error('Erro ao salvar preferência no servidor:', error);
                    }
                });

                // --- LÓGICA DE VALIDAÇÃO DE SENHAS ---
                const inputSenha = document.getElementById('senha');
                const inputConfirmar = document.getElementById('confirmar-senha');
                const btnSalvar = document.getElementById('btn-salvar');
                const msgSenha = document.getElementById('mensagem-senha');

                function validarSenhas() {
                    if (inputSenha.value || inputConfirmar.value) {
                        if (inputSenha.value !== inputConfirmar.value) {
                            inputConfirmar.classList.add('input-erro');
                            inputConfirmar.classList.remove('input-sucesso');
                            msgSenha.textContent = "As senhas não coincidem!";
                            msgSenha.style.color = "#ef4444";
                            btnSalvar.disabled = true;
                            btnSalvar.style.opacity = '0.5';
                            btnSalvar.style.cursor = 'not-allowed';
                        } else {
                            inputConfirmar.classList.remove('input-erro');
                            inputConfirmar.classList.add('input-sucesso');
                            msgSenha.textContent = "Senhas coincidem!";
                            msgSenha.style.color = "#16a34a";
                            btnSalvar.disabled = false;
                            btnSalvar.style.opacity = '1';
                            btnSalvar.style.cursor = 'pointer';
                        }
                    } else {
                        inputConfirmar.classList.remove('input-erro', 'input-sucesso');
                        msgSenha.textContent = "";
                        btnSalvar.disabled = false;
                        btnSalvar.style.opacity = '1';
                        btnSalvar.style.cursor = 'pointer';
                    }
                }

                inputSenha.addEventListener('input', validarSenhas);
                inputConfirmar.addEventListener('input', validarSenhas);
            </script>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>