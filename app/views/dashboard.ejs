<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - TaskBee</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="shortcut icon" type="image/x-icon" href="/TaskBee-Icon.ico">
    <script>
        const backendTheme = '<%= (locals.usuario && usuario.tema) ? usuario.tema : "" %>';
        const localTheme = localStorage.getItem('tema');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        
        let themeToApply = 'light';
        if (backendTheme && backendTheme !== 'system' && backendTheme !== '') {
            themeToApply = backendTheme;
        } else if (localTheme && localTheme !== 'system' && localTheme !== '') {
            themeToApply = localTheme;
        } else if (systemPrefersDark) {
            themeToApply = 'dark';
        }
        
        if (themeToApply === 'dark') {
            document.documentElement.classList.add('dark-mode');
        }
    </script>
</head>
<body>
    <%- include('partials/header') %>
    
    <main class="container-pagina">
        <div class="cabecalho-pagina">
            <h1>Painel de Controle (Dashboard)</h1>
            <p class="subtitulo">Acompanhe as métricas e os chamados mais recentes em tempo real.</p>
        </div>

        <!-- Métricas Principais -->
        <section class="cards-metrica">
            <div class="card-metrica total">
                <span class="metrica-titulo">Total de Chamados</span>
                <span class="metrica-valor"><%= estatisticas.total_chamados || 0 %></span>
            </div>
            <div class="card-metrica abertos">
                <span class="metrica-titulo">Abertos</span>
                <span class="metrica-valor"><%= estatisticas.chamados_abertos || 0 %></span>
            </div>
            <div class="card-metrica andamento">
                <span class="metrica-titulo">Em Andamento</span>
                <span class="metrica-valor"><%= estatisticas.chamados_andamento || 0 %></span>
            </div>
            <div class="card-metrica concluidos">
                <span class="metrica-titulo">Concluídos</span>
                <span class="metrica-valor"><%= estatisticas.chamados_concluidos || 0 %></span>
            </div>
        </section>

        <!-- Tabela de Chamados Recentes -->
        <section class="secao-card">
            <h2>Últimos Chamados</h2>
            <div class="tabela-container">
                <table class="tabela-padrao">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Status</th>
                            <th>Prioridade</th>
                            <th>Data de Criação</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (ultimosChamados && ultimosChamados.length > 0) { %>
                            <% ultimosChamados.forEach(chamado => { %>
                                <tr>
                                    <td><strong>#<%= chamado.id %></strong></td>
                                    <td><%= chamado.title %></td>
                                    <td>
                                        <span class="tag-status status-<%= (chamado.status || '').toLowerCase().replace(' ', '-') %>">
                                            <%= chamado.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="tag-prioridade prioridade-<%= (chamado.priority || '').toLowerCase() %>">
                                            <%= chamado.priority %>
                                        </span>
                                    </td>
                                    <td><%= new Date(chamado.created_at).toLocaleDateString('pt-BR') %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="sem-dados">Nenhum chamado encontrado.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>