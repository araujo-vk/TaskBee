<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - TaskBee</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="shortcut icon" type="image/x-icon" href="/TaskBee-Icon.ico">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            const backendTheme = '<%= (locals.usuario && usuario.tema) ? usuario.tema : "" %>';
            const localTheme = localStorage.getItem('tema');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = backendTheme && backendTheme !== 'system' ? backendTheme
                : (localTheme && localTheme !== 'system' ? localTheme : (systemPrefersDark ? 'dark' : 'light'));
            document.documentElement.classList.toggle('dark-mode', theme === 'dark');
        })();
    </script>
</head>
<body>
    <%- include('partials/header') %>
    <% 
        const stats = locals.estatisticas || {};
        const listaChamados = locals.ultimosChamados || [];
        const categorias = locals.porCategoria || [];
        const prioridades = locals.porPrioridade || [];
        const filtro = locals.filtroAtivo || 'todos';
        const periodo = locals.periodoAtivo || '30';
        const periodoQuery = `periodo=${encodeURIComponent(periodo)}`;
        const valorKpi = valor => Number(valor || 0).toLocaleString('pt-BR', { maximumFractionDigits: 1 });
        const formatarDataHora = data => data ? new Date(data).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) : 'N/A';
    %>

    <main id="conteudo-principal" class="container-pagina">
        <div class="barra-painel">
            <form action="/chamados" method="GET" role="search">
                <label class="sr-only" for="busca-painel">Buscar chamados</label>
                <input id="busca-painel" type="search" name="busca" placeholder="Buscar chamados por título ou ID">
                <button type="submit">Buscar</button>
            </form>
            <a href="/chamados/novo">Novo chamado</a>
        </div>
        <div class="cabecalho-pagina cabecalho-dashboard">
            <div>
                <h1>Painel de Controle</h1>
                <p class="subtitulo">Indicadores operacionais, prioridades e cumprimento de SLA.</p>
            </div>
            <div class="acoes-dashboard">
                <a class="btn-secundario-dashboard" href="/exportar/chamados.csv">Exportar chamados</a>
                <% if (usuario && [1, 2].includes(Number(usuario.roleId))) { %>
                    <a class="btn-secundario-dashboard" href="/exportar/sla.csv">Exportar SLA</a>
                <% } %>
            </div>
        </div>

        <form class="filtro-periodo" action="/dashboard" method="GET">
            <input type="hidden" name="filtro" value="<%= filtro %>">
            <label for="periodo">Período analisado</label>
            <select id="periodo" name="periodo" onchange="this.form.submit()">
                <option value="7" <%= periodo === '7' ? 'selected' : '' %>>Últimos 7 dias</option>
                <option value="30" <%= periodo === '30' ? 'selected' : '' %>>Últimos 30 dias</option>
                <option value="90" <%= periodo === '90' ? 'selected' : '' %>>Últimos 90 dias</option>
                <option value="todos" <%= periodo === 'todos' ? 'selected' : '' %>>Todo o histórico</option>
            </select>
            <noscript><button type="submit">Aplicar</button></noscript>
        </form>

        <section class="cards-metrica" aria-label="Indicadores de chamados">
            <a href="/dashboard?filtro=atrasados&<%= periodoQuery %>" class="card-link"><div class="card-metrica atrasados destaque-alerta <%= filtro === 'atrasados' ? 'ativo' : '' %>"><span class="metrica-titulo">SLA atrasado</span><span class="metrica-valor"><%= valorKpi(stats.chamados_atrasados) %></span></div></a>
            <a href="/dashboard?filtro=urgentes&<%= periodoQuery %>" class="card-link"><div class="card-metrica urgentes destaque-urgente <%= filtro === 'urgentes' ? 'ativo' : '' %>"><span class="metrica-titulo">Urgentes</span><span class="metrica-valor"><%= valorKpi(stats.chamados_urgentes) %></span></div></a>
            <a href="/dashboard?filtro=abertos&<%= periodoQuery %>" class="card-link"><div class="card-metrica abertos <%= filtro === 'abertos' ? 'ativo' : '' %>"><span class="metrica-titulo">Abertos</span><span class="metrica-valor"><%= valorKpi(stats.chamados_abertos) %></span></div></a>
            <a href="/dashboard?filtro=andamento&<%= periodoQuery %>" class="card-link"><div class="card-metrica andamento <%= filtro === 'andamento' ? 'ativo' : '' %>"><span class="metrica-titulo">Em andamento</span><span class="metrica-valor"><%= valorKpi(stats.chamados_andamento) %></span></div></a>
            <a href="/dashboard?filtro=concluidos&<%= periodoQuery %>" class="card-link"><div class="card-metrica concluidos <%= filtro === 'concluidos' ? 'ativo' : '' %>"><span class="metrica-titulo">Concluídos</span><span class="metrica-valor"><%= valorKpi(stats.chamados_concluidos) %></span></div></a>
            <a href="/dashboard?filtro=todos&<%= periodoQuery %>" class="card-link"><div class="card-metrica total <%= filtro === 'todos' ? 'ativo' : '' %>"><span class="metrica-titulo">Total</span><span class="metrica-valor"><%= valorKpi(stats.total_chamados) %></span></div></a>
        </section>

        <section class="cards-kpi" aria-label="Indicadores de desempenho">
            <article class="kpi-card"><span>Tempo médio de resposta</span><strong><%= valorKpi(stats.tempo_medio_resposta_horas) %> h</strong></article>
            <article class="kpi-card"><span>Tempo médio de resolução</span><strong><%= valorKpi(stats.tempo_medio_resolucao_horas) %> h</strong></article>
            <article class="kpi-card"><span>SLA cumprido nos concluídos</span><strong><%= valorKpi(stats.cumprimento_sla_percentual) %>%</strong></article>
        </section>

        <section class="secao-graficos" aria-label="Distribuições de chamados">
            <article class="grafico-card">
                <div class="grafico-header"><h2>Chamados por categoria</h2><p>Principais origens de demanda no período.</p></div>
                <div class="grafico-wrapper"><canvas id="graficoCategorias" data-labels="<%= JSON.stringify(categorias.map(item => item.nome)) %>" data-values="<%= JSON.stringify(categorias.map(item => item.quantidade)) %>"></canvas></div>
            </article>
            <article class="grafico-card">
                <div class="grafico-header"><h2>Chamados por prioridade</h2><p>Volume distribuído por criticidade.</p></div>
                <div class="grafico-wrapper"><canvas id="graficoPrioridades" data-labels="<%= JSON.stringify(prioridades.map(item => item.nome)) %>" data-values="<%= JSON.stringify(prioridades.map(item => item.quantidade)) %>"></canvas></div>
            </article>
        </section>

        <section class="secao-card">
            <div class="secao-cabecalho"><h2>Chamados <%= filtro !== 'todos' ? `— ${filtro}` : 'recentes' %></h2></div>
            <div class="tabela-container">
                <table class="tabela-padrao">
                    <thead><tr><th>ID</th><th>Título</th><th>Status</th><th>Prioridade</th><th>Abertura</th><th>Vencimento SLA</th><th>Situação</th></tr></thead>
                    <tbody>
                        <% if (listaChamados.length) { listaChamados.forEach(chamado => { %>
                            <% const statusNome = String(chamado.status || '').toLowerCase(); const prioridadeNome = String(chamado.priority || '').toLowerCase(); const finalizado = ['resolvido', 'fechado', 'concluido', 'concluído'].includes(statusNome); %>
                            <tr class="<%= chamado.is_atrasado ? 'linha-atrasada' : '' %>">
                                <td><a class="link-detalhes" href="/chamados/<%= chamado.id %>">#<%= chamado.id %></a></td>
                                <td class="coluna-titulo"><%= chamado.title || 'Sem título' %></td>
                                <td><span class="tag-status status-<%= statusNome.replace(/\s+/g, '-') %>"><%= chamado.status || 'Indefinido' %></span></td>
                                <td><span class="tag-prioridade prioridade-<%= prioridadeNome.replace(/\s+/g, '-') %>"><%= chamado.priority || 'Não definida' %></span></td>
                                <td><%= formatarDataHora(chamado.created_at) %></td>
                                <td><%= chamado.resolution_due_at ? formatarDataHora(chamado.resolution_due_at) : 'Sem SLA' %></td>
                                <td><span class="tag-sla <%= finalizado ? 'concluido' : (chamado.is_atrasado ? 'atrasado' : 'no-prazo') %>"><%= finalizado ? 'Finalizado' : (chamado.is_atrasado ? 'Atrasado' : 'No prazo') %></span></td>
                            </tr>
                        <% }); } else { %>
                            <tr><td colspan="7" class="sem-dados">Nenhum chamado encontrado para o filtro escolhido.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
    <%- include('partials/footer') %>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const dark = document.documentElement.classList.contains('dark-mode');
            const textColor = dark ? '#f8fafc' : '#1e293b';
            const gridColor = dark ? '#3f3f46' : '#e2e8f0';
            const criarGrafico = (id, cor) => {
                const canvas = document.getElementById(id);
                if (!canvas || !window.Chart) return;
                const labels = JSON.parse(canvas.dataset.labels || '[]');
                const valores = JSON.parse(canvas.dataset.values || '[]');
                new Chart(canvas.getContext('2d'), {
                    type: 'bar',
                    data: { labels, datasets: [{ data: valores, backgroundColor: cor, borderRadius: 6, maxBarThickness: 48 }] },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: textColor }, grid: { display: false } }, y: { beginAtZero: true, ticks: { color: textColor, precision: 0 }, grid: { color: gridColor } } } }
                });
            };
            criarGrafico('graficoCategorias', '#f97316');
            criarGrafico('graficoPrioridades', '#fadc21');
        });
    </script>
</body>
</html>
