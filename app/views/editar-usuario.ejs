<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Usuário - TaskBee</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/painel-forms.css">
    <link rel="shortcut icon" type="image/x-icon" href="/TaskBee-Icon.ico">
    <script>
        (function() {
            // Usa 'locals.usuario' para evitar erros caso o usuário não esteja logado
            const backendTheme = '<%= (locals.usuario && usuario.tema) ? usuario.tema : "" %>';
            const localTheme = localStorage.getItem('tema');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            
            let themeToApply = 'light';
            
            // 1. Se houver preferência vinda do banco de dados (usuário logado)
            if (backendTheme && backendTheme !== 'system' && backendTheme !== '') {
                themeToApply = backendTheme;
            } 
            // 2. Se houver preferência no localStorage (visitante que já mudou o tema)
            else if (localTheme && localTheme !== 'system' && localTheme !== '') {
                themeToApply = localTheme;
            } 
            // 3. Senão, adota a preferência do sistema operacional/navegador
            else if (systemPrefersDark) {
                themeToApply = 'dark';
            }
            
            // Aplica imediatamente na tag <html> para evitar a tela branca ao carregar
            if (themeToApply === 'dark') {
                document.documentElement.classList.add('dark-mode');
            } else {
                document.documentElement.classList.remove('dark-mode');
            }
        })();
    </script>
</head>
<body>
    <%- include('partials/header') %>

    <main class="container-form">
        <h2>Editar: <%= usuario.nome %></h2>
        <p class="subtitulo">ID do Usuário: <%= usuario.id %></p>

        <form action="/gestao-usuarios/editar/<%= usuario.id %>" method="POST">
            <label for="nome">Nome:</label>
            <input type="text" id="nome" name="nome" value="<%= usuario.nome %>" required>

            <label for="email">E-mail:</label>
            <input type="email" id="email" name="email" value="<%= usuario.email %>" required>

            <label for="department_id">Departamento:</label>
            <select id="department_id" name="department_id">
                <option value="">-- Selecione um Departamento --</option>
                <% departamentos.forEach(dep => { %>
                    <option value="<%= dep.id %>" <%= usuario.department_id == dep.id ? 'selected' : '' %>>
                        <%= dep.name %>
                    </option>
                <% }) %>
            </select>

            <label for="role_id">Nível de Acesso (Perfil):</label>
            <select id="role_id" name="role_id" required>
                <% roles.forEach(role => { %>
                    <option value="<%= role.id %>" <%= usuario.role_id == role.id ? 'selected' : '' %>>
                        <%= role.name %>
                    </option>
                <% }) %>
            </select>

            <label for="is_active">Status da Conta:</label>
            <select id="is_active" name="is_active" required>
                <option value="1" <%= usuario.is_active == 1 ? 'selected' : '' %>>Ativo</option>
                <option value="0" <%= usuario.is_active == 0 ? 'selected' : '' %>>Inativo</option>
            </select>

            <div class="botoes-acao">
                <button type="submit" class="btn-principal">Salvar Alterações</button>
                <a href="/gestao-usuarios" class="btn-secundario">Cancelar</a>
            </div>
        </form>

        <hr>

        <a href="/gestao-usuarios/deletar/<%= usuario.id %>" 
           onclick="return confirm('Tem certeza que deseja deletar este usuário? Esta ação não pode ser desfeita.');" 
           class="btn-deletar">
            Deletar Usuário
        </a>
    </main>

    <%- include('partials/footer') %>
</body>
</html>