<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Página Inicial - ITSM</title>
</head>
<body>

    <div style="background-color: #222; color: #fff; padding: 10px 20px; font-family: monospace;">
        <% if (typeof usuario !== 'undefined' && usuario) { %>
            <span style="color: #00ff00;">● SESSÃO ATIVA</span> | 
            Usuário: <strong><%= usuario.nome %></strong> | 
            ID: <%= usuario.id %> | 
            Role ID: <%= usuario.role %> |
            <a href="/logout" style="color: #ff6666; margin-left: 15px;">[Sair]</a>
        <% } else { %>
            <span style="color: #ff4444;">● NENHUMA SESSÃO ATIVA (Visitante)</span> | 
            <a href="/login" style="color: #44ffff; margin-left: 15px;">[Fazer Login]</a>
        <% } %>
    </div>

    <main style="padding: 20px;">
        <h1>Sistema ITSM</h1>

        <% if (typeof usuario !== 'undefined' && usuario) { %>
            <h3>Bem-vindo de volta, <%= usuario.nome %>!</h3>
            <p>Seu nível de acesso no banco é: <%= usuario.role %></p>
        <% } else { %>
            <p>Você está navegando como visitante. Por favor, faça login para acessar o painel.</p>
        <% } %>
    </main>

</body>
</html>

<p>index</p>

