<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - TaskBee</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="shortcut icon" type="image/x-icon" href="/TaskBee-Icon.ico">
</head>
<body>
    <%- include('partials/header') %>

    <div class="container">
        <p>Acesso ao Sistema</p>

        <% if (typeof erro !== 'undefined' && erro) { %>
            <p style="color: red; font-size: 13px; font-weight: 500;"><%= erro %></p>
        <% } %>

        <% if (typeof mensagem !== 'undefined' && mensagem) { %>
            <p style="color: var(--cor-laranja); font-size: 13px; font-weight: 500;"><%= mensagem %></p>
        <% } %>

        <div class="form-container">
            <form action="/login" method="POST">
                <label for="cnpj_empresa">CNPJ da Empresa:</label>
                <input type="text" id="cnpj_empresa" name="cnpj_empresa" placeholder="00.000.000/0001-00" required>

                <label for="email">E-mail:</label>
                <input type="email" id="email" name="email" placeholder="seu.email@empresa.com" required>

                <label for="senha">Senha:</label>
                <input type="password" id="senha" name="senha" placeholder="******" required>

                <button type="submit">Entrar</button>
            </form>
        </div>

        <a href="/cadastro">Solicitar cadastro de usuário</a><br>
        <a href="/cadastro-empresa">Cadastrar uma nova empresa</a>
    </div>

    <%- include('partials/footer') %>
</body>
</html>