<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Novo Chamado - TaskBee</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/painel-forms.css">
    <link rel="shortcut icon" type="image/x-icon" href="/TaskBee-Icon.ico">
    <%- include('partials/appearance') %>
</head>
<body>
    <%- include('partials/header') %>
    
    <main class="container-form">
        <h2>Abrir Novo Chamado</h2>
        <% const dados = locals.valores || {}; %>
        <form action="/chamados/novo" method="POST">
            <label for="titulo">Título do Chamado:</label>
            <input type="text" id="titulo" name="titulo" maxlength="200" value="<%= dados.titulo || '' %>" required>

            <label for="descricao">Descrição:</label>
            <textarea id="descricao" name="descricao" rows="5" required><%= dados.descricao || '' %></textarea>

            <label for="tipo">Tipo de Chamado:</label>
            <select id="tipo" name="tipo" required>
                <option value="incidente" <%= dados.tipo === 'incidente' ? 'selected' : '' %>>Incidente</option>
                <option value="requisicao" <%= dados.tipo === 'requisicao' ? 'selected' : '' %>>Requisição</option>
                <option value="problema" <%= dados.tipo === 'problema' ? 'selected' : '' %>>Problema</option>
                <option value="mudanca" <%= dados.tipo === 'mudanca' ? 'selected' : '' %>>Mudança</option>
                <option value="outro" <%= dados.tipo === 'outro' ? 'selected' : '' %>>Outro</option>
            </select>

            <label for="category_id">Categoria:</label>
            <select id="category_id" name="category_id" required>
                <option value="">Selecione uma categoria</option>
                <% (categorias || []).forEach(categoria => { %>
                    <option value="<%= categoria.id %>" <%= Number(dados.categoryId) === Number(categoria.id) ? 'selected' : '' %>>
                        <%= categoria.name %>
                    </option>
                <% }) %>
            </select>

            <label for="priority_id">Prioridade:</label>
            <select id="priority_id" name="priority_id" required>
                <option value="">Selecione uma prioridade</option>
                <% (prioridades || []).forEach(prioridade => { %>
                    <option value="<%= prioridade.id %>" <%= Number(dados.priorityId) === Number(prioridade.id) ? 'selected' : '' %>>
                        <%= prioridade.name %>
                    </option>
                <% }) %>
            </select>

            <label for="service_id">Serviço relacionado:</label>
            <select id="service_id" name="service_id">
                <option value="">Nenhum serviço específico</option>
                <% (servicos || []).forEach(servico => { %>
                    <option value="<%= servico.id %>" <%= Number(dados.serviceId) === Number(servico.id) ? 'selected' : '' %>>
                        <%= servico.name %>
                    </option>
                <% }) %>
            </select>
            
            <button type="submit" class="btn-principal">Enviar Chamado</button>
        </form>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
