<!-- views/partials/header.ejs -->
<link rel="stylesheet" href="/css/header.css">

<header class="site-header">
    <div class="logo">
        <a href="/"><img src="/TaskBee-logo.png" alt="TaskBee"></a>
    </div>
    
    <!-- Botão Hambúrguer (exibido apenas no mobile) -->
    <button class="hamburger-btn" id="hamburgerBtn" aria-label="Abrir Menu">
        ☰
    </button>
    
    <nav class="nav-links" id="navLinks">
        <% if (usuario) { %>
            <span class="saudacao">Olá, <%= usuario.nome || usuario.name %>!</span>
            <a href="/chamados">Meus Chamados</a>
            <a href="/chamados/novo">Novo Chamado</a>
            
            <% if (usuario.roleId === 1 || usuario.roleId === 2) { %>
                <a href="/gestao-usuarios">Gestão de Usuários</a>
            <% } %>
            
            <a href="/logout" class="btn-logout">Sair</a>
        <% } else { %>
            <a href="/login">Entrar</a>
            <a href="/cadastro">Cadastrar</a>
            <a href="/cadastro-empresa" class="btn-destaque">Cadastrar Empresa</a>
        <% } %>
    </nav>
</header>

<script>
    const hamburgerBtn = document.getElementById('hamburgerBtn');
    const navLinks = document.getElementById('navLinks');

    hamburgerBtn.addEventListener('click', () => {
        navLinks.classList.toggle('ativo');
    });
</script>